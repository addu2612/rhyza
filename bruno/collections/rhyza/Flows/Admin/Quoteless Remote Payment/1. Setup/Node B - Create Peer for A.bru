meta {
  name: Node B - Create Peer for A
  type: http
  seq: 7
}

post {
  url: http://{{adminB}}/peers
  body: json
  auth: none
}

body:json {
  {
    "id": "9f3c1e2a-4b5d-4c6e-8a7f-1b2c3d4e5f60",
    "name": "Node A",
    "assetCode": "USD",
    "assetScale": 2,
    "ilpStaticAddress": "private.rhyza.a",
    "http": {
      "outgoing": {
        "endpoint": "http://ilp-connector-service:4000/ilp",
        "authToken": "local-peer-token"
      },
      "incoming": {
        "authToken": "local-peer-token"
      }
    }
  }
}

vars:pre-request {
  adminB: localhost:4001
}

tests {
  test("created or already exists", function () {
    expect([201, 409]).to.include(res.getStatus());
  });
}
