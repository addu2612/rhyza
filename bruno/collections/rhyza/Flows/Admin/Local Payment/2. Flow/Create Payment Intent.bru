meta {
  name: Create Payment Intent
  type: http
  seq: 1
}

post {
  url: http://{{adminApiUrl}}/payment-intents
  body: json
  auth: none
}

body:json {
  {
    "walletAddress": "receiver",
    "incomingAmount": 100
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body?.id) {
    bru.setVar("paymentIntentId", body.id);
  }
}
